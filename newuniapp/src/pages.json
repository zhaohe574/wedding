    "preloadRule": {
        "pages/index/index": {
            "network": "wifi",
            "packages": ["packages/pkg-catalog", "packages/pkg-order"]
        },
        "pages/query/query": {
            "network": "all",
            "packages": ["packages/pkg-catalog"]
        },
        "pages/feed/feed": {
            "network": "wifi",
            "packages": ["packages/pkg-catalog"]
        },
        "pages/user/user": {
            "network": "wifi",
            "packages": ["packages/pkg-order", "packages/pkg-user"]
        }
    },
    "globalStyle": {
