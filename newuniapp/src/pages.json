    "easycom": {
        "autoscan": true,
        "custom": {
            "router-navigate": "uniapp-router-next/components/router-navigate/router-navigate.vue",
            "^w-(.*)": "@/components/widgets/$1/$1.vue",
            // ---- 图鸟 UI V3 ----
            // 通用规则：tn-xxx → components/xxx/src/xxx.vue
            // 例外：图鸟有 11 个目录内含多个 .vue（如 checkbox 目录内同时有 checkbox.vue 与
            // checkbox-group.vue），通用规则拼不出路径，必须先列单项规则。
            // easycom 按声明顺序匹配，例外项必须写在通用规则之前。
            "^tn-avatar-group$": "@tuniao/tnui-vue3-uniapp/components/avatar/src/avatar-group.vue",
            "^tn-checkbox-group$": "@tuniao/tnui-vue3-uniapp/components/checkbox/src/checkbox-group.vue",
            "^tn-collapse-item$": "@tuniao/tnui-vue3-uniapp/components/collapse/src/collapse-item.vue",
            "^tn-form-item$": "@tuniao/tnui-vue3-uniapp/components/form/src/form-item.vue",
            "^tn-notice-bar$": "@tuniao/tnui-vue3-uniapp/components/notice-bar/src/notice-bar.vue",
            "^tn-column-notice-bar$": "@tuniao/tnui-vue3-uniapp/components/notice-bar/src/column-notice-bar.vue",
            "^tn-row-notice-bar$": "@tuniao/tnui-vue3-uniapp/components/notice-bar/src/row-notice-bar.vue",
            "^tn-radio-group$": "@tuniao/tnui-vue3-uniapp/components/radio/src/radio-group.vue",
            "^tn-steps-item$": "@tuniao/tnui-vue3-uniapp/components/steps/src/steps-item.vue",
            "^tn-subsection-item$": "@tuniao/tnui-vue3-uniapp/components/subsection/src/subsection-item.vue",
            "^tn-swipe-action-item$": "@tuniao/tnui-vue3-uniapp/components/swipe-action/src/swipe-action-item.vue",
            "^tn-tabbar-item$": "@tuniao/tnui-vue3-uniapp/components/tabbar/src/tabbar-item.vue",
            "^tn-tabs-item$": "@tuniao/tnui-vue3-uniapp/components/tabs/src/tabs-item.vue",
            "^tn-(.*)": "@tuniao/tnui-vue3-uniapp/components/$1/src/$1.vue"
        }
    }
}
