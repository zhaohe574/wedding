        "navigationBarTitleText": "婚庆服务",
        "navigationBarBackgroundColor": "#FFFFFF",
        "backgroundColor": "#F8F6F0",
        "h5": {
            "navigationStyle": "custom"
        }
    },
    "tabBar": {
        "custom": true,
        "color": "#9A948B",
        "selectedColor": "#C6A15B",
        "backgroundColor": "#FFFFFF",
        "borderStyle": "white",
        "list": [
            {
                "pagePath": "pages/index/index",
                "text": "首页"
