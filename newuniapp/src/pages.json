{
    "pages": [
        {
            // 首页必须是 pages[0]：开屏广告改为首页上的 fixed 首屏层。
            // 旧方案用非 Tab 的开屏页做 pages[0]，再 switchTab 到首页，
            // 在自定义 tabBar 下实测会等待约 10 秒（首页 JS 才开始执行）。
            // 首页直接启动后，开屏层与首页数据同时开始，没有第二次页面装载。
            "path": "pages/index/index",
            "style": {
                // #ifndef H5
                "navigationStyle": "custom",
                // #endif
                // #ifdef H5
                "navigationBarTitleText": "首页",
                // #endif
                "enablePullDownRefresh": false,
                "disableScroll": true,
                // 首屏是深色主图：窗口底色同墨黑。
                // 开屏层退出时不应露出浅色窗口底，否则这一帧会闪白。
                "backgroundColor": "#14110F",
                "backgroundColorTop": "#14110F",
                // 首帧即深色主图：状态栏前景色在冷启动第一帧就必须是白字，
                // 不能等 nav-bar 挂载后再切（那一帧会先闪一次黑字压深图）。
                "navigationBarTextStyle": "white"
            }
        },
        {
            // 兼容页：正常冷启动不经过这里，开屏层直接挂在首页上。
            // 保留注册是为了旧链接 / 调试直达不会 404。
            "path": "pages/splash/splash",
            "style": {
                "navigationStyle": "custom",
                "disableScroll": true,
                // #ifdef H5
                "navigationBarTitleText": "首页",
                // #endif
                "backgroundColor": "#14110F",
                // 开屏层整屏墨黑：首帧状态栏同样按白字渲染
                "navigationBarTextStyle": "white"
            }
        },
        {
            "path": "pages/feed/feed",
            "style": {
                // #ifndef H5
                "navigationStyle": "custom",
                // #endif
                // #ifdef H5
                "navigationBarTitleText": "动态",
                // #endif
                // 下拉刷新与滚动交给 page-shell 内置 scroll-view（:pull-refresh）：
                // 关掉页面级下拉与整页滚动，否则真机上下拉会带着顶部导航一起走
                "enablePullDownRefresh": false,
                "disableScroll": true
            }
        },
        {
            "path": "pages/query/query",
            "style": {
                // #ifndef H5
                "navigationStyle": "custom",
                // #endif
                // #ifdef H5
                "navigationBarTitleText": "查档期",
                // #endif
