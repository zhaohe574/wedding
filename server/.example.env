APP_DEBUG = true

[ADMIN]
# 后台登录 IP 变化检测：1 开启，0 关闭。家宽动态 IP 频繁变化时可临时设为 0。
CHECK_LOGIN_IP = "1"

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = test
USERNAME = username
PASSWORD = password
HOSTPORT = 3306
CHARSET = utf8mb4
DEBUG = true
PREFIX = la_

[LANG]
default_lang = zh-cn

[PROJECT]
UNIQUE_IDENTIFICATION = likeadmin
# 演示环境
DEMO_ENV = false
CRONTAB_SECRET = ""

[CACHE]
DRIVER = redis
HOST = 127.0.0.1
PORT = 6379
PASSWORD = ""
