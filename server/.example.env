# 生产环境必须为 false；为 true 时页面型应用会回显错误细节。
APP_DEBUG = false

[ADMIN]
# 后台登录 IP 变化检测：1 开启，0 关闭。家宽动态 IP 频繁变化时可临时设为 0。
CHECK_LOGIN_IP = "1"

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = test
USERNAME = username
PASSWORD = password
HOSTPORT = 3306
CHARSET = utf8mb4
# 开启后会把完整 SQL 写入 runtime 日志，其中包含 token、手机号等敏感值。
# 只在本地排障时临时设为 true，排查完立即改回 false，且不要提交日志文件。
DEBUG = false
PREFIX = la_

[LANG]
default_lang = zh-cn

[CORS]
# 允许跨域访问的来源，逗号分隔，例如 https://admin.example.com,https://ops.example.com
# 留空表示保持通配（*）但不允许携带 Cookie，仅适用于 token 走请求头的场景。
# 生产环境建议填写实际域名，避免任意站点调用后台接口。
ALLOWED_ORIGINS = ""

[PROJECT]
UNIQUE_IDENTIFICATION = likeadmin
# 演示环境
DEMO_ENV = false
CRONTAB_SECRET = ""

[CACHE]
DRIVER = redis
HOST = 127.0.0.1
PORT = 6379
PASSWORD = ""
